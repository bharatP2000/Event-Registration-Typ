# UPI details shown under the QR code on the registration page (optional —
# the QR image itself is what people actually scan; this is just a text
# fallback for people who prefer to type the UPI ID manually).
UPI_ID=sethiavijay3@okhdfcbank
UPI_PAYEE_NAME=Vijay Sethia

# Registration fee, in INR (rupees). Example: 499
EVENT_FEE_INR=499

# Event name shown on the registration page
EVENT_NAME=Yuva Yogkshem Shivir

# Event date/time shown on the registration page (free text, shown as-is)
EVENT_DATE=23 August 2026
EVENT_TIME=9:30 AM onwards

# Port the server listens on
PORT=3000

# ---- Storage ----
# By default, registrations (including payment screenshots, stored inline
# as base64) are saved to a local JSON file — fine for local development,
# but LOST on redeploy/restart on hosts with an ephemeral filesystem
# (Render/Railway, especially free tiers).
#
# Recommended for deployment: create a free database at
# https://console.upstash.com (no credit card needed) and paste its
# REST URL/token below. When both are set, Redis is used automatically
# and the JSON file is ignored. See README "Deploying" section.
# Note: since screenshots are embedded in each record, a busy event can
# use up Upstash's free-tier storage faster than before — keep an eye on it.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Only used when the Upstash variables above are left blank, and only if
# your host gives you a persistent disk/volume to point it at.
# DATA_DIR=/var/data

# Simple password-style key required to download the Excel export
# (append it as ?key=... to the export URL). Change this to something private.
ADMIN_EXPORT_KEY=change-me-please

# Comma-separated list of areas shown in the dropdown
EVENT_AREAS=North Zone,South Zone,East Zone,West Zone,Central
